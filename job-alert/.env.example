# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_CHANNEL=amazonukjobsalert

# Push: ntfy (free). Pick a long random topic name, subscribe in the ntfy phone app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Optional, loudest (bypasses silent mode, repeats until acknowledged)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Filters
HOME_POSTCODE=HA1 3QH
MAX_HOURS=20
# Straight-line miles from home. ~2h travel: 40 covers London, Watford, Slough, Luton, Dartford, Crawley.
RADIUS_MILES=40
ALERT_UNKNOWN_HOURS=1
