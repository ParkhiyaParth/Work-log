# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Channel username (without @) or numeric id
TG_CHANNEL=

# Push: ntfy (free). Pick a long random topic name, subscribe to it in the ntfy phone app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Optional, loudest option (bypasses silent mode): Pushover emergency priority
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Filters
MAX_HOURS=20
# Comma-separated, case-insensitive substrings matched against the post text
LOCATION_KEYWORDS=london,croydon,dartford,watford,slough,romford,barking,enfield,uxbridge,heathrow,stratford,bexleyheath,harrow,wembley,bromley,sutton,kingston,ilford,tilbury,purfleet,hemel
# Postcode outward prefixes (London + border)
POSTCODE_PREFIXES=E,EC,N,NW,SE,SW,W,WC,BR,CR,DA,EN,HA,IG,KT,RM,SM,TW,UB,WD,SL,TN
